# ============================================================
# Sourcing Agent - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Hunter.io API ---
# 1. Sign up at https://hunter.io (free plan = 25 searches/month)
# 2. Go to https://hunter.io/api-keys
# 3. Copy your API key and paste it here
HUNTER_API_KEY=your_hunter_api_key_here

# Minimum confidence score (0-100) to include a contact.
# 0 = include all, 80+ = only high confidence
HUNTER_MIN_CONFIDENCE=0

# --- Google Sheets ---
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or use existing)
# 3. Enable "Google Sheets API" in APIs & Services
# 4. Go to Credentials > Create Credentials > Service Account
# 5. Download the JSON key file and save it (e.g. ./credentials.json)
# 6. Create a Google Sheet and copy its ID from the URL:
#    https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
# 7. Share the sheet with the service account email
#    (it looks like: name@project.iam.gserviceaccount.com)

GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_PATH=./credentials.json

# --- Scheduler ---
# Cron expression for when to run (default: 8am daily)
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=America/Los_Angeles

# --- Data ---
# Directory for dedup tracking and local data
DATA_DIR=./data
